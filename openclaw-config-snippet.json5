// Merge these entries; preserve existing plugins, models, and allowlists.
{
  plugins: {
    load: { paths: ["/absolute/path/to/cli-tap-out"] },
    allow: ["claude-auth-router"],
    entries: { "claude-auth-router": { enabled: true, config: {} } }
  },
  agents: {
    defaults: {
      models: {
        "claude/claude-sonnet-4-6": {
          alias: "sonnet"
        }
      },
      modelPolicy: { allow: ["claude/claude-sonnet-4-6"] }
    }
  }
}
