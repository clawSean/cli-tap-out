{
  "name": "@clawsean/cli-tap-out",
  "version": "0.3.0",
  "type": "module",
  "description": "Standalone Claude CLI backend with account routing for OpenClaw",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./src/index.mjs"
    ],
    "runtimeExtensions": [
      "./src/index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.3",
      "minGatewayVersion": "2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.3",
      "pluginSdkVersion": "2026.9.3"
    },
    "setupEntry": "./src/setup.mjs",
    "runtimeSetupEntry": "./src/setup.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "src/",
    "openclaw.plugin.json",
    "claude-auth-router.sh",
    "claude-profiles.example.json",
    "README.md",
    "openclaw-config-snippet.json5",
    "test/"
  ],
  "private": true
}
