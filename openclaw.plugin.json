{
  "id": "claude-auth-router",
  "name": "Claude Account Router",
  "version": "0.3.0",
  "description": "Standalone claude backend with subscription account routing.",
  "cliBackends": [
    "claude"
  ],
  "setup": {
    "cliBackends": [
      "claude"
    ],
    "requiresRuntime": true
